echo "📝 Formatting and linting staged files..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Linting failed"
  exit 1
fi

# Type check
echo ""
echo "🔎 Type checking..."
npm run type-check

if [ $? -ne 0 ]; then
