# ──────────────────────────────────────────────────────────
# Sprint-Flow — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────
# Node environment: development | production | test
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string
# Local Docker example: postgresql://postgres:password@localhost:5432/sprintflow
# Supabase example:     postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/sprintflow

# ── Authentication (JWT) ──────────────────────────────────
# Secret used to sign JWT access tokens — minimum 32 random characters
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# How long access tokens stay valid (e.g. 15m, 1h, 1d)
ACCESS_TOKEN_EXPIRES_IN=15m

# Set to "1" ONLY if this app is deployed behind infrastructure that itself overwrites
# X-Forwarded-For / X-Real-IP (Vercel, an nginx/ALB reverse proxy, etc.) rather than
# passing through whatever a client sends. When unset, the login/signup rate limiter
# treats all direct requests as one shared bucket instead of trusting a spoofable
# client-supplied IP header.
TRUST_PROXY_HEADERS=0

# ── Google OAuth 2.0 ──────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ──────────────────────────────────────────────────────────
# API smoke-test script (scripts/api-smoke-test.ts) — optional
# Only needed when running the local API test harness.
# ──────────────────────────────────────────────────────────

# Base URL the smoke test targets
API_BASE_URL=http://localhost:3000

# Fail the run on any non-critical assertion when set to "1"
STRICT_API_TEST=0

# Per-request timeout in milliseconds
API_TEST_TIMEOUT_MS=15000

# Enable performance comparison when set to "1"
API_PERF_COMPARE=0

# Number of concurrent requests during perf comparison
API_PERF_CONCURRENCY=5

# Percentage of requests to run validation on during perf comparison
PERF_VALIDATION_PERCENT=5

# Credentials used to create / sign in the test user
TEST_EMAIL=api-test@example.com
TEST_PASSWORD=Passw0rd!123
TEST_NAME=API Test User

# Override the sign-in credentials separately (defaults to TEST_* above)
SIGNIN_EMAIL=
SIGNIN_PASSWORD=

# Pre-existing tokens to reuse instead of signing in
ACCESS_TOKEN=
REFRESH_TOKEN=

# Raw Cookie header to send with requests (overrides ACCESS/REFRESH tokens)
COOKIE_HEADER=
